# ─── Optional paid providers ────────────────────────────────────────────────
# System works with zero keys set — deterministic planner + SVG graphics + silent audio
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ─── Local provider endpoints (defaults shown) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
KOKORO_BASE_URL=http://localhost:8880

# ─── Server config ────────────────────────────────────────────────────────
PORT=3001
OUTPUT_DIR=/tmp/sfv-output
CACHE_DIR=/tmp/sfv-cache
CACHE_TTL_HOURS=24

# ─── Demo / dry-run mode ──────────────────────────────────────────────────
# DEMO_MODE=1 forces the deterministic planner, skips paid stock APIs, and
# uses silent TTS so a full pipeline run can be tested without spending any
# credits or hitting external services.
# DEMO_MODE=0
