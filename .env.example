# =============================================================================
# Solana Meme-Coin Trading Bot — Example Environment
# =============================================================================
# Copy this to `.env` and fill in. NEVER commit .env. NEVER paste a private key
# directly into source. Use a file path (PRIVATE_KEY_PATH) on a host you trust.
# =============================================================================

# ---- Mode flags -------------------------------------------------------------
# Default: paper trading. Live trading requires BOTH flags to be set.
PAPER_TRADING=true
LIVE_TRADING=false

# Independent gate for launchpad live trading (still requires LIVE_TRADING=true)
ENABLE_LIVE_LAUNCHPAD_TRADING=false

# ---- API endpoints / keys ---------------------------------------------------
SOLANA_RPC_URL=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
X_BEARER_TOKEN=
JUPITER_API_KEY=

# ---- Wallet -----------------------------------------------------------------
# Public key only here. Private key is loaded from a file path you control.
WALLET_PUBLIC_KEY=
PRIVATE_KEY_PATH=./keys/trading-wallet.json

# ---- Position / loss limits -------------------------------------------------
MAX_TRADE_SOL=0.05
MAX_WALLET_PERCENT_PER_TRADE=1
MAX_DAILY_LOSS_SOL=0.2
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_MINUTES=20
SAFETY_RESERVE_SOL=0.5

# ---- Token quality gates ----------------------------------------------------
MIN_TOKEN_LIQUIDITY_USD=50000
MIN_VOLUME_5M_USD=10000
MIN_VOLUME_1H_USD=50000
MIN_UNIQUE_BUYERS_5M=20
MAX_PRICE_IMPACT_PERCENT=3
MAX_SLIPPAGE_BPS=300
MAX_TOP_10_HOLDER_PERCENT=35
MAX_SINGLE_HOLDER_PERCENT=10

# ---- Score thresholds (0–100) ----------------------------------------------
SMART_WALLET_MIN_SCORE=75
BUZZ_SCORE_THRESHOLD=70
EVENT_SCORE_THRESHOLD=80
NARRATIVE_SCORE_THRESHOLD=70
TOKEN_SAFETY_THRESHOLD=75
LIVE_BUY_THRESHOLD=85

# ---- Copy-trade specific ----------------------------------------------------
COPY_TRADE_MAX_DELAY_SECONDS=20
COPY_TRADE_MAX_MOVE_AFTER_WALLET_ENTRY_PERCENT=25

# ---- Module enables ---------------------------------------------------------
ENABLE_SMART_WALLET_TRACKING=true
ENABLE_X_MONITORING=true
ENABLE_NEWS_EVENTS=true
ENABLE_PUMPFUN_SCANNER=true
ENABLE_MIGRATION_SCANNER=true
ENABLE_DEXSCREENER_TRENDING=true
ENABLE_NARRATIVE_ROTATION=true

# ---- Kill switch ------------------------------------------------------------
# Create this file (any contents) to immediately halt all new trades.
KILL_SWITCH_FILE=STOP_BOT.txt

# ---- Database ---------------------------------------------------------------
DB_PATH=./data/bot.sqlite

# ---- Exit defaults (tuned for the meme-coin reversal pattern) ---------------
# Faster partial profits: meme coins peak fast and reverse. Three sells of 33%
# at +30%, +70%, +150% locks in the gain before the typical fade. Trailing
# stop tightened to 15% to ride the runner without giving back too much. Hard
# stop at 25% caps individual loser size.
PROFIT_LADDER=30:0.33,70:0.33,150:0.33
TRAILING_STOP_PERCENT=15
HARD_STOP_LOSS_PERCENT=25
TIME_BASED_EXIT_MINUTES=180
