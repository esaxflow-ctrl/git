# ─── Optional paid providers ────────────────────────────────────────────────
# System works with zero keys set — deterministic planner + SVG graphics + silent audio
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENROUTER_API_KEY=

# ─── Local provider endpoints (defaults shown) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
KOKORO_BASE_URL=http://localhost:8880

# ─── Server config ────────────────────────────────────────────────────────
PORT=3001
OUTPUT_DIR=/tmp/sfv-output
CACHE_DIR=/tmp/sfv-cache
CACHE_TTL_HOURS=24
