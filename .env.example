# ─── Optional paid providers ────────────────────────────────────────────────
# System works with zero keys set — deterministic planner + SVG graphics + silent audio
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ElevenLabs realistic neural TTS. Free tier = 10K chars/month (~4 sixty-second
# scripts). Sign up at https://elevenlabs.io and grab the key from Profile.
ELEVENLABS_API_KEY=
# Optional voice override — name from the default library (rachel, adam, antoni,
# bella, domi, elli, josh, sam) or a raw voice ID from your dashboard. Default: adam.
# ELEVENLABS_VOICE_ID=adam
# Optional model override. Default eleven_turbo_v2_5 is fast + cheap. Use
# eleven_multilingual_v2 for higher quality at higher cost.
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# ─── Local provider endpoints (defaults shown) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
KOKORO_BASE_URL=http://localhost:8880

# ─── Server config ────────────────────────────────────────────────────────
PORT=3001
OUTPUT_DIR=/tmp/sfv-output
CACHE_DIR=/tmp/sfv-cache
CACHE_TTL_HOURS=24

# ─── Demo / dry-run mode ──────────────────────────────────────────────────
# DEMO_MODE=1 forces the deterministic planner, skips paid stock APIs, and
# uses silent TTS so a full pipeline run can be tested without spending any
# credits or hitting external services.
# DEMO_MODE=0

# ─── Optional LLM enhancements ────────────────────────────────────────────
# ENABLE_SCRIPT_POLISH=1 makes the script generator run a final Ollama
# polish pass over the filled template — same structure, more natural
# wording. Adds 30–60s to the first run while the model loads. Falls
# back to the unpolished template if Ollama isn't reachable.
# ENABLE_SCRIPT_POLISH=1

# SCRIPT_PROVIDER=ollama (or openrouter) skips the template path entirely
# and asks the LLM to write the script from scratch. Less reliable than
# templates but useful if you want pure-LLM output.
# SCRIPT_PROVIDER=ollama
