# ── Polymarket API ────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Wallet private key for on-chain signing (NEVER commit the real key)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# ── Execution mode ────────────────────────────────────────────────────────────
# Options: alert_only | paper | manual_approval | semi_auto | full_auto
EXECUTION_MODE=alert_only

# ── Risk limits ───────────────────────────────────────────────────────────────
BANKROLL_USD=1000
MAX_POSITION_SPECULATIVE_PCT=0.25
MAX_POSITION_STRONG_PCT=0.50
MAX_POSITION_CLUSTER_PCT=1.00
MAX_CATEGORY_EXPOSURE_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=10.0
MAX_DAILY_LOSSES=3
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_PRICE_DRIFT_FROM_ENTRY_PCT=20.0
MAX_SPREAD_PCT=5.0
MIN_LIQUIDITY_USD=5000

# ── Signal thresholds ─────────────────────────────────────────────────────────
MIN_SIGNAL_SCORE_AUTO=85
MIN_WALLET_SHARP_SCORE_AUTO=80
MIN_SIGNAL_SCORE_ALERT=40

# ── Wallet discovery ──────────────────────────────────────────────────────────
MIN_MARKETS_TRADED=10
MIN_RESOLVED_MARKETS=5
LEADERBOARD_FETCH_LIMIT=200
WALLET_REFRESH_INTERVAL_SECONDS=3600
TRACKER_POLL_INTERVAL_SECONDS=60

# ── Alerts ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_LOG_FILE=alerts.jsonl

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///polymarket_tracker.db
