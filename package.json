{
  "name": "solana-meme-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Solana meme-coin discovery and trading framework with strict risk controls. Paper-trading first.",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "scan": "tsx src/index.ts --mode=scan",
    "paper": "tsx src/index.ts --mode=paper",
    "backtest": "tsx src/backtest/backtester.ts",
    "live": "tsx src/index.ts --mode=live",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
